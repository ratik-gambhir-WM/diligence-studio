# Server-side OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Microsoft Entra ID confidential web app configuration
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:43127/api/auth/callback
MICROSOFT_FRONTEND_ORIGIN=http://localhost:5173
# Set this to true in both the server and web environments to require Microsoft sign-in.
MICROSOFT_SUPPORT=false

# Cookies are secure by default; set this to false for local HTTP development.
MICROSOFT_COOKIE_SECURE=false

# Comma-separated SharePoint hosts accepted by the SharePoint link resolver.
SHAREPOINT_ALLOWED_HOSTS=relentlessblue.sharepoint.com
