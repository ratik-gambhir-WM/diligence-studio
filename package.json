{
  "name": "diligence-studio",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @diligence-studio/web",
    "web:dev": "npm run dev --workspace @diligence-studio/web",
    "api": "node --env-file=.env --import tsx server/src/server.ts",
    "server:dev": "npm run dev --workspace @diligence-studio/server",
    "server:start": "npm run start --workspace @diligence-studio/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "server:typecheck": "npm run typecheck --workspace @diligence-studio/server",
    "test": "npm run test --workspaces --if-present",
    "server:test": "npm run test --workspace @diligence-studio/server",
    "build": "npm run build --workspace @diligence-studio/web",
    "pptx:to-json": "npm run pptx:to-json --workspace @diligence-studio/server --"
  }
}
